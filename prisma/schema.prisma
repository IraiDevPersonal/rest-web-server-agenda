// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model roles {
  id    Int           @id @default(autoincrement())
  name  String
  users users_roles[]
}

model users_roles {
  user_id BigInt
  user    users  @relation(fields: [user_id], references: [id])
  role_id Int
  role    roles  @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
}

model professions {
  id                       Int                        @id @default(autoincrement())
  name                     String
  professional_professions professional_professions[]
}

model professional_professions {
  user_id       BigInt
  user          users       @relation(fields: [user_id], references: [id])
  profession_id Int
  profession    professions @relation(fields: [profession_id], references: [id])

  @@id([profession_id, user_id])
}

model users {
  id           BigInt                     @id @default(autoincrement())
  uid          String                     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rut          String                     @unique
  names        String                     @default("")
  last_names   String                     @default("")
  email        String                     @unique
  password     String                     @default("")
  phone        String                     @default("")
  status       UserStatus                 @default(ACTIVE)
  avatar_image String?                    @default("")
  address      String                     @default("")
  gender       Gender
  roles        users_roles[]
  professions  professional_professions[]
  appointments appointments[]
}

model appointments {
  id                 BigInt            @id @default(autoincrement())
  uid                String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            BigInt
  date               DateTime          @db.Date
  time_from          String
  time_to            String
  patient_id         BigInt?
  is_enabled         Boolean           @default(true)
  user               users             @relation(fields: [user_id], references: [id])
  appointment_status AppointmentStatus @default(AVAILABLE)
  patient            patients?         @relation(fields: [patient_id], references: [id])
}

model patients {
  id           BigInt         @id @default(autoincrement())
  uid          String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rut          String         @unique
  names        String         @default("")
  last_names   String         @default("")
  email        String         @unique
  phone        String         @default("")
  address      String         @default("")
  birth_date   DateTime       @default(now()) @db.Date
  status       UserStatus     @default(ACTIVE)
  gender       Gender
  appointments appointments[]
}

enum Gender {
  MA @map("masculine")
  FE @map("feminine")
}

enum UserStatus {
  ACTIVE   @map("ACTIVE")
  INACTIVE @map("INACTIVE")
  BLOCKED  @map("BLOQUED")
}

enum AppointmentStatus {
  TO_CONFIRM    @map("to-confirm")
  CONFIRMED     @map("confirmed")
  CANCELLED     @map("cancelled")
  AVAILABLE     @map("available")
  INDETERMINATE @map("indeterminate")
}
